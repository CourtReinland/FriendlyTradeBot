# FriendlyTradeBot Environment Variables
# Copy to .env and fill in your values (never commit .env)

# Data providers
POLYGON_API_KEY=your_polygon_key_here
FRED_API_KEY=your_fred_key_here

# Rockflow (paper first!)
ROCKFLOW_API_KEY=your_rockflow_key
ROCKFLOW_ACCOUNT_ID=paper_or_live_account_id
ROCKFLOW_BASE_URL=https://api.rockflow.com  # confirm with their docs

# Optional: Telegram / Discord alerts later
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Experiment tracking (optional)
WANDB_API_KEY=  # if using W&B free tier
